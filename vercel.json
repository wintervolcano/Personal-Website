{
    "functions": {
        "api/*.py": {
            "runtime": "python3.10"
        }
    },
    "rewrites": [
        {
            "source": "/globular-cluster-explorer",
            "destination": "/globular-clusters-3d.html"
        },
        {
            "source": "/((?!api).*)",
            "destination": "/"
        }
    ]
}
